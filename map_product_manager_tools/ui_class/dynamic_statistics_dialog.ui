<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>DynamicStatisticsDialog</class>
 <widget class="QDialog" name="DynamicStatisticsDialog">
  <property name="geometry">
   <rect>
    <x>0</x>
    <y>0</y>
    <width>1200</width>
    <height>800</height>
   </rect>
  </property>
  <property name="windowTitle">
   <string>动态统计</string>
  </property>
  <property name="windowIcon">
   <iconset resource="../map_product_manager_tools.qrc">
    <normaloff>:/images/statistics.svg</normaloff>
   </iconset>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <!-- ========== 顶部过滤栏 ========== -->
   <item>
    <widget class="QGroupBox" name="filterGroupBox">
     <property name="title">
      <string>筛选条件</string>
     </property>
     <layout class="QHBoxLayout" name="filterLayout">
      <item>
       <widget class="QLabel" name="granularityLabel">
        <property name="text">
         <string>时间粒度：</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QComboBox" name="granularityCombo">
        <item>
         <property name="text">
          <string>按年统计</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>按月统计</string>
         </property>
        </item>
        <item>
         <property name="text">
          <string>按季度统计</string>
         </property>
        </item>
       </widget>
      </item>
      <item>
       <spacer name="filterSpacer1">
        <property name="orientation">
         <enum>Qt::Horizontal</enum>
        </property>
        <property name="sizeType">
         <enum>QSizePolicy::Fixed</enum>
        </property>
        <property name="sizeHint" stdset="0">
         <size><width>20</width><height>20</height></size>
        </property>
       </spacer>
      </item>
      <item>
       <widget class="QLabel" name="dateFromLabel">
        <property name="text">
         <string>起始日期：</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QDateEdit" name="dateFromEdit">
        <property name="displayFormat">
         <string>yyyy-MM-dd</string>
        </property>
        <property name="calendarPopup">
         <bool>true</bool>
        </property>
        <property name="date">
         <date><year>2020</year><month>1</month><day>1</day></date>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QLabel" name="dateToLabel">
        <property name="text">
         <string>结束日期：</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QDateEdit" name="dateToEdit">
        <property name="displayFormat">
         <string>yyyy-MM-dd</string>
        </property>
        <property name="calendarPopup">
         <bool>true</bool>
        </property>
        <property name="date">
         <date><year>2099</year><month>12</month><day>31</day></date>
        </property>
       </widget>
      </item>
      <item>
       <spacer name="filterSpacer2">
        <property name="orientation">
         <enum>Qt::Horizontal</enum>
        </property>
        <property name="sizeType">
         <enum>QSizePolicy::Fixed</enum>
        </property>
        <property name="sizeHint" stdset="0">
         <size><width>15</width><height>20</height></size>
        </property>
       </spacer>
      </item>
      <item>
       <widget class="QPushButton" name="refreshBtn">
        <property name="text">
         <string>查询统计</string>
        </property>
        <property name="icon">
         <iconset resource="../map_product_manager_tools.qrc"/>
        </property>
        <property name="minimumWidth">
         <number>100</number>
        </property>
       </widget>
      </item>
      <item>
       <spacer name="filterHorizSpacer">
        <property name="orientation">
         <enum>Qt::Horizontal</enum>
        </property>
        <property name="sizeHint" stdset="0">
         <size><width>40</width><height>20</height></size>
        </property>
       </spacer>
      </item>
     </layout>
    </widget>
   </item>

   <!-- ========== 主体：左侧配置面板 + 右侧统计表格 ========== -->
   <item>
    <widget class="QSplitter" name="mainSplitter">
     <property name="orientation">
      <enum>Qt::Horizontal</enum>
     </property>

     <!-- 左侧配置面板 -->
     <widget class="QWidget" name="leftConfigPanel">
      <property name="minimumSize">
       <size><width>260</width><height>0</height></size>
      </property>
      <property name="maximumSize">
       <size><width>320</width><height>16777215</height></size>
      </property>
      <layout class="QVBoxLayout" name="leftConfigLayout">
       <property name="leftMargin">
        <number>4</number>
       </property>
       <property name="topMargin">
        <number>4</number>
       </property>
       <property name="rightMargin">
        <number>4</number>
       </property>
       <property name="bottomMargin">
        <number>4</number>
       </property>

       <!-- 统计列配置 -->
       <item>
        <widget class="QGroupBox" name="columnConfigBox">
         <property name="title">
          <string>统计列配置（勾选要显示的列）</string>
         </property>
         <layout class="QVBoxLayout" name="columnConfigLayout">
          <item>
           <widget class="QTreeWidget" name="metricTree">
            <property name="font">
             <font>
              <family>微软雅黑</family>
              <pointsize>9</pointsize>
             </font>
            </property>
            <property name="headerLabels">
             <stringlist><string>指标名称</string></stringlist>
            </property>
            <property name="rootIsDecorated">
             <bool>false</bool>
            </property>
            <property name="itemsExpandable">
             <bool>false</bool>
            </property>
            <property name="selectionMode">
             <enum>QAbstractItemView::NoSelection</enum>
            </property>
           </widget>
          </item>
          <item>
           <layout class="QHBoxLayout" name="metricBtnLayout">
            <item>
             <widget class="QPushButton" name="selectAllMetricsBtn">
              <property name="text"><string>全选</string></property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="deselectAllMetricsBtn">
              <property name="text"><string>取消全选</string></property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>

       <!-- 图件种类配置 -->
       <item>
        <widget class="QGroupBox" name="mapCategoryConfigBox">
         <property name="title">
          <string>图件种类配置（灵活修改）</string>
         </property>
         <layout class="QVBoxLayout" name="mapCategoryLayout">
          <item>
           <widget class="QListWidget" name="mapCategoryList">
            <property name="font">
             <font>
              <family>微软雅黑</family>
              <pointsize>9</pointsize>
             </font>
            </property>
           </widget>
          </item>
          <item>
           <layout class="QHBoxLayout" name="categoryBtnLayout">
            <item>
             <widget class="QPushButton" name="addCategoryBtn">
              <property name="text"><string>添加</string></property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="editCategoryBtn">
              <property name="text"><string>编辑</string></property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="removeCategoryBtn">
              <property name="text"><string>删除</string></property>
             </widget>
            </item>
           </layout>
          </item>
          <item>
           <layout class="QHBoxLayout" name="categoryExtraBtnLayout">
            <item>
             <widget class="QPushButton" name="resetCategoryBtn">
              <property name="text"><string>恢复默认</string></property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </widget>

     <!-- 右侧统计结果区域 -->
     <widget class="QWidget" name="rightPanel">
      <layout class="QVBoxLayout" name="rightLayout">
       <property name="leftMargin">
        <number>4</number>
       </property>
       <property name="topMargin">
        <number>4</number>
       </property>
       <property name="rightMargin">
        <number>4</number>
       </property>
       <property name="bottomMargin">
        <number>4</number>
       </property>

       <!-- 统计结果表格 -->
       <item>
        <widget class="QGroupBox" name="resultGroupBox">
         <property name="title">
          <string>统计结果</string>
         </property>
         <layout class="QVBoxLayout" name="resultLayout">
          <item>
           <widget class="QTableWidget" name="statsTable">
            <property name="font">
             <font>
              <family>微软雅黑</family>
              <pointsize>9</pointsize>
             </font>
            </property>
            <property name="alternatingRowColors">
             <bool>true</bool>
            </property>
            <property name="selectionBehavior">
             <enum>QAbstractItemView::SelectRows</enum>
            </property>
            <property name="editTriggers">
             <set>QAbstractItemView::NoEditTriggers</set>
            </property>
            <property name="sortingEnabled">
             <bool>true</bool>
            </property>
           </widget>
          </item>
         </layout>
        </widget>
       </item>

       <!-- 导出按钮栏 -->
       <item>
        <widget class="QGroupBox" name="exportGroupBox">
         <property name="title">
          <string>导出格式</string>
         </property>
         <layout class="QHBoxLayout" name="exportLayout">
          <item>
           <widget class="QPushButton" name="exportExcelBtn">
            <property name="text">
             <string>导出 Excel</string>
            </property>
            <property name="minimumWidth">
             <number>120</number>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="exportPdfBtn">
            <property name="text">
             <string>导出 PDF</string>
            </property>
            <property name="minimumWidth">
             <number>120</number>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="exportPngBtn">
            <property name="text">
             <string>导出 PNG</string>
            </property>
            <property name="minimumWidth">
             <number>120</number>
            </property>
           </widget>
          </item>
          <item>
           <spacer name="exportSpacer">
            <property name="orientation">
             <enum>Qt::Horizontal</enum>
            </property>
            <property name="sizeHint" stdset="0">
             <size><width>40</width><height>20</height></size>
            </property>
           </spacer>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </widget>
    </widget>
   </item>

  </layout>
 </widget>
 <resources>
  <include location="../map_product_manager_tools.qrc"/>
 </resources>
 <connections/>
</ui>
