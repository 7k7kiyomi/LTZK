QToolButton#catalogToolbarButton { color: #3D5540; background: #F4EBD7; border: 1px solid #8B9872; padding: 2px; }
QToolButton#catalogToolbarButton:hover { color: #FFF8EC; background: #6C7956; border-color: #526443; }

/* Workspace and plugin frame hierarchy: outer shell -> nested sections -> controls. */
QTabWidget#workspaceSideTabs QTabBar { background: #F1E5CD; border: 1px solid #C9B88F; }
#workspaceLayerTreePanelWidget { background: #F1E5CD; border: 0; }
QGroupBox[ltzkFrameDepth="0"] { border: 2px solid #6C7956; }
QGroupBox[ltzkFrameDepth="1"] { border: 1px solid #B9B992; }
QGroupBox[ltzkFrameDepth="2"] { border: 1px solid #B86F4F; }
QTableView, QTableWidget, QTreeView, QTreeWidget, QListView { border: 1px solid #B9B992; }
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QDateTimeEdit, QComboBox { border: 1px solid #C9B88F; }

/* Refined quiet frame treatment: structure comes from surfaces, not glow. */
QTabWidget#workspaceSideTabs QTabBar { background: #F0EBDD; border: 1px solid #C1B99F; }
QTabWidget#workspaceSideTabs::pane { background: #F0EBDD; border: 1px solid #C1B99F; }
#workspaceLayerTreePanelWidget { background: #F0EBDD; border: 0; }
QGroupBox { background: #F3EDDE; border: 1px solid #C5BDA6; }
QGroupBox[ltzkFrameDepth="0"] { background: #EBE3CF; border: 1px solid #9A9B77; border-left: 2px solid #7F8F66; }
QGroupBox[ltzkFrameDepth="1"] { background: #F3EDDE; border: 1px solid #B7B79B; }
QGroupBox[ltzkFrameDepth="2"] { background: #F8F1E3; border: 1px solid #D0B092; }
QTableView, QTableWidget, QTreeView, QTreeWidget, QListView { background: #F8F2E6; alternate-background-color: #EFE7D7; border: 1px solid #BEB9A4; gridline-color: #DED6C4; }
QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QDateTimeEdit, QComboBox { background: #FBF7ED; border: 1px solid #C3BDA6; }
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QDateTimeEdit:focus, QComboBox:hover, QComboBox:focus { border: 1px solid #87936B; background: #FFF9ED; }
QComboBox::drop-down, QDateEdit::drop-down, QDateTimeEdit::drop-down { border-left: 1px solid #C3BDA6; }
QComboBox QAbstractItemView { border: 1px solid #C3BDA6; }
QPushButton:hover, QToolButton:hover { border: 1px solid #87936B; }
QScrollArea { background: transparent; border: 1px solid #C8C1A9; }
QFrame[dashboardPanel="true"] { background: #F0EBDD; border: 1px solid #C1B99F; border-radius: 4px; border-left: 2px solid #87936B; }
QTreeView::branch:open:has-children:!has-siblings, QTreeView::branch:open:has-children:has-siblings { image: url(:/LTZK/Resources/tree_branch_open_light_theme.svg); width: 16px; height: 16px; }
QTreeView::branch:closed:has-children:!has-siblings, QTreeView::branch:closed:has-children:has-siblings { image: url(:/LTZK/Resources/tree_branch_closed_light_theme.svg); width: 16px; height: 16px; }

/* Visible workspace actions rise above the strip on hover. */
QToolButton[topBarTool="true"]:hover, QToolButton[topBarTool="true"][topBarRaised="true"] {
    color: #fff8ec;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #72815c, stop:1 #526443);
    border: 2px solid #b86f4f;
    border-top: 2px solid #fff8ec;
    border-bottom: 4px solid #9a5539;
    border-radius: 6px;
    padding: 4px 6px 5px 6px;
}










QLineEdit[ltzkMetadataPlaceholder="true"] { color: rgba(100, 116, 139, 190); }

/* Series cell typography follows its view; the host supplies the resolved
   font after scaling. These scoped rules own spacing, not a second font size. */
QTreeWidget[ltzkSeriesCellTypography="true"] QLineEdit,
QTreeWidget[ltzkSeriesCellTypography="true"] QPushButton,
QTreeWidget[ltzkSeriesCellTypography="true"] QToolButton {
    padding: 0px 4px;
    min-height: 0px;
    font-weight: normal;
}
